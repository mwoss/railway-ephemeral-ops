{
  "name": "railway-runner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run codegen:safe && next build",
    "start": "next start",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "biome format .",
    "format:fix": "biome format --write .",
    "check": "biome check .",
    "check:fix": "biome check --write .",
    "codegen": "graphql-codegen --config codegen.ts",
    "codegen:safe": "npm run codegen || echo 'Skipping codegen, using existing generated files'",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.90.10",
    "date-fns": "^4.1.0",
    "graphql": "^16.12.0",
    "graphql-request": "^7.3.4",
    "highlight.js": "^11.11.1",
    "lucide-react": "^0.554.0",
    "next": "^16.0.0",
    "pino": "^10.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.7",
    "@graphql-codegen/cli": "^6.1.0",
    "@graphql-codegen/typescript": "^5.0.5",
    "@graphql-codegen/typescript-graphql-request": "^6.3.0",
    "@graphql-codegen/typescript-operations": "^5.0.5",
    "@jest/globals": "^30.2.0",
    "@tailwindcss/postcss": "^4.1.17",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "jest": "^30.2.0",
    "jest-environment-node": "^30.2.0",
    "postcss": "^8",
    "tailwindcss": "^4.1.17",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  }
}
